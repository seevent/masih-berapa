# Supabase Configuration
# Copy file ini menjadi .env dan isi dengan kredensial Supabase Anda:

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# URL publik aplikasi yang dipakai di QR code label (default: https://masih-berapa.vercel.app)
VITE_PUBLIC_APP_URL=https://masih-berapa.vercel.app

# Cloudinary: penyimpanan foto evidence transaksi (unggah unsigned dari browser, tanpa secret).
# Buat unsigned upload preset di Cloudinary (Settings > Upload > Upload presets), mis. "masih_berapa_evidence",
# Signing mode: Unsigned, folder: masih-berapa/evidence. Isi cloud name dan nama preset-nya:
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
