# Supabase Configuration
# Copy file ini menjadi .env dan isi dengan kredensial Supabase Anda:

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# URL publik aplikasi yang dipakai di QR code label (default: https://masih-berapa.vercel.app)
VITE_PUBLIC_APP_URL=https://masih-berapa.vercel.app
